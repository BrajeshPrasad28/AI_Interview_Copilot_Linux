# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Ultra-fast 0.5s answers & Whisper transcription: https://console.groq.com/)
GROQ_API_KEY=

# Server Configuration
HOST=0.0.0.0
# Optional: set PORT to request a fixed port; otherwise the OS selects an available port.

# Dashboard API base URL (override only if using a different environment)
DASHBOARD_API_URL=https://www.avintrax.in
# Optional: set privately if the dashboard requires a shared application secret.
# DASHBOARD_APP_SECRET=

# Optional: Fixed pairing token (random 16-byte token generated automatically if omitted)
# PAIRING_TOKEN=your_custom_secret_token

# Preferred Coding Language for DSA questions (python, java, cpp, javascript)
DEFAULT_CODING_LANG=python

# Default Interview Mode (general, coding, system_design, behavioral)
DEFAULT_MODE=general

# Desktop window title
APP_NAME=Bluetooth Driver

# Rolling Context Window turns (default 5 question-answer pairs = 10 messages)
MAX_HISTORY_TURNS=5
