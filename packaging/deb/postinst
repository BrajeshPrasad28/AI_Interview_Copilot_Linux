#!/bin/sh
set -eu

APP_DIR=/opt/ai-interview-copilot
VENV="$APP_DIR/.venv"

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv --system-site-packages "$VENV"
fi

"$VENV/bin/python" -m pip install --disable-pip-version-check --upgrade pip
"$VENV/bin/python" -m pip install --disable-pip-version-check --no-input -r "$APP_DIR/requirements.txt"

exit 0
