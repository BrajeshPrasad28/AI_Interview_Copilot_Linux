                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"f733a8d7-c393-4fe4-a7e9-203a942c2a7f\",\n  \"machine_id\": \"27d031eb-bacc-4dbc-9086-e191b1d373ee\",\n  \"name\": \"Brajesh Pasad\",\n  \"email\": \"brajesh.prasad28@gmail.com\",\n  \"phone\": \"+918723969733\",\n  \"balance\": 392.5,\n  \"transactions\": [\n    {\n      \"id\": \"TXN-551669\",\n      \"type\": \"debit\",\n      \"amount\": 7.5,\n      \"balance_after\": 92.5,\n      \"description\": \"Copilot Session\",\n      \"timestamp\": \"2026-11-25 01:51 AM\"\n    }\n  ]\n}"
